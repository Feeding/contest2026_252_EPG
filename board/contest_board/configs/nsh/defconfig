#
# cmocka board self test ("cmocka_bk7258_test" from NSH).
#
# TESTING_CMOCKA wants LIBC_REGEX, which is MIT-licensed and therefore
# gated behind ALLOW_MIT_COMPONENTS, and LIBC_EXECFUNCS, which the cmocka
# runner uses to spawn the individual suites.
#
# ARCH_SETJMP_H is the one that is not obvious.  cmocka reports a failed
# assertion by longjmp'ing out of the case, and this image links with
# -nostdlib against libgcc and libm only, so the toolchain's setjmp never
# arrives.  ARCH_SETJMP_H builds NuttX's own ARM setjmp/longjmp and
# redirects <setjmp.h> at it.  Nothing else in this image uses setjmp, so
# the redirected jmp_buf affects only cmocka.
#
CONFIG_ARCH_SETJMP_H=y
CONFIG_ALLOW_MIT_COMPONENTS=y
CONFIG_LIBC_REGEX=y
CONFIG_LIBC_EXECFUNCS=y
CONFIG_TESTING_CMOCKA=y
CONFIG_TESTING_BK7258=y
CONFIG_SCHED_HAVE_PARENT=y
CONFIG_SCHED_LPWORK=y
CONFIG_PIPES=y
CONFIG_LIBC_FLOATINGPOINT=y
CONFIG_PSEUDOFS_SOFTLINKS=y
CONFIG_TESTS_TESTSUITES=y
CONFIG_TESTS_TESTSUITES_STACKSIZE=16384
CONFIG_CM_MM_TEST=y
CONFIG_CM_SCHED_TEST=y
CONFIG_CM_SYSCALL_TEST=y
CONFIG_TESTING_OSTEST=y
CONFIG_TESTING_GETPRIME=y
CONFIG_TESTING_MM=y
CONFIG_TESTING_SCANFTEST=y
CONFIG_EXAMPLES_HELLO=y
CONFIG_EXAMPLES_PIPE=y
CONFIG_EXAMPLES_POPEN=y
CONFIG_SYSTEM_POPEN=y
CONFIG_TESTING_DRIVER_TEST=y
CONFIG_TESTING_DRIVER_TEST_STACKSIZE=8192
CONFIG_FS_TMPFS=y
CONFIG_FS_LINKS=y
CONFIG_LIBC_SCANSET=y
CONFIG_LIBC_LONG_LONG=y
CONFIG_TESTS_TESTSUITES_MOUNT_DIR="/tmp"
CONFIG_RTC_ALARM=y
CONFIG_RTC_PERIODIC=y
CONFIG_RTC_IOCTL=y
CONFIG_RTC_DATETIME=y
CONFIG_DRIVERS_RTC=y
CONFIG_SIG_EVTHREAD=y
CONFIG_ONESHOT=y
CONFIG_ALARM_ARCH=y
CONFIG_ONESHOT_COUNT=y
